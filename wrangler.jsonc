{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unehaus",
  "compatibility_date": "2026-08-01",
  // global_fetch_strictly_public: the OAuth provider fetches client metadata
  // documents (CIMD) by URL, and this flag keeps those fetches off private
  // and same-zone origins.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/server.ts",
  "vars": {
    "VITE_ENVIRONMENT": "production",
  },
  // Run the worker near the D1 primary (WEUR) instead of near the visitor —
  // per-request DB round-trips dominate over first-hop latency.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unehaus",
      "database_id": "65de246d-e126-41e9-854c-f7a848c432c1",
      "migrations_dir": "drizzle",
    },
  ],
  // Grants, tokens and registered clients for the /mcp OAuth server.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "45f74d892d464715b8a37eed28883e14",
    },
  ],
  "triggers": {
    // Keep in sync with ROTATION_CRON in src/lib/games/rius/lifecycle.ts and
    // the dispatch table in src/server.ts. Workers crons fire in UTC. Weekdays
    // are named, never numbered: Cloudflare counts 1-7 from Sunday, so a
    // numeric "1" is Sunday here rather than Monday.
    "crons": ["0 0 * * MON", "0 * * * *"],
  },
}
