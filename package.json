{
  "name": "une.haus",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter web build",
    "preflight": "bun run scripts/preflight.ts",
    "deploy": "bun run scripts/deploy.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "oxlint --fix && oxfmt --write",
    "clean": "bun run --filter '*' clean",
    "db:migrate": "bun run --filter web db:migrate",
    "test": "bun run --filter '*' test:unit",
    "test:integration": "bun run --filter '*' test:integration",
    "scan": "bunx @shadscan/cli@latest apps/web --no-interactive"
  },
  "devDependencies": {
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0"
  },
  "overrides": {
    "nitro": "3.0.1-alpha.1"
  },
  "patchedDependencies": {
    "cmdk@1.1.1": "apps/web/patches/cmdk@1.1.1.patch"
  }
}
