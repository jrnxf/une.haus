# Everything under /assets/ is content-hashed by Vite — safe to cache forever.
# Without this, Workers static assets serve max-age=0 and the browser
# revalidates fonts/CSS/JS on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker keeps its address across deploys; the browser must check
# it on every load to pick up a new one.
/sw.js
  Cache-Control: no-cache
